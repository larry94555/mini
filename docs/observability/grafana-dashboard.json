{
  "title": "imini overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Runs (ok vs failed)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_IMINI"
      },
      "targets": [
        {
          "expr": "imini_counter{name=\"runs_ok\"}",
          "legendFormat": "ok"
        },
        {
          "expr": "imini_counter{name=\"runs_failed\"}",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 2,
      "title": "Run latency (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_IMINI"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "imini_run_latency_avg_ms",
          "legendFormat": "avg",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "imini_run_latency_p50_ms",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "C",
          "expr": "imini_run_latency_p95_ms",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "D",
          "expr": "imini_run_latency_max_ms",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Tool calls by name",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_IMINI"
      },
      "targets": [
        {
          "expr": "imini_tool_calls",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Concurrency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_IMINI"
      },
      "targets": [
        {
          "expr": "imini_concurrency_active",
          "legendFormat": "active"
        },
        {
          "expr": "imini_concurrency_queued",
          "legendFormat": "queued"
        },
        {
          "expr": "imini_concurrency_limit",
          "legendFormat": "limit"
        }
      ]
    },
    {
      "id": 5,
      "title": "Uptime (seconds)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_IMINI"
      },
      "targets": [
        {
          "expr": "imini_uptime_seconds",
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "id": 6,
      "title": "Approx output tokens",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_IMINI"
      },
      "targets": [
        {
          "expr": "imini_approx_output_tokens",
          "legendFormat": "tokens"
        }
      ]
    },
    {
      "id": 7,
      "title": "Runs by endpoint",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_IMINI"
      },
      "targets": [
        {
          "expr": "imini_runs_by_endpoint",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Requests by API key",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PROM_IMINI"
      },
      "targets": [
        {
          "expr": "imini_requests_by_key",
          "legendFormat": "{{key}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Run success rate (%)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "imini_run_success_rate",
          "legendFormat": "success",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "p95 run latency (ms)",
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "imini_run_latency_p95_ms",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    }
  ]
}